# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# development | production (en production se apagan /docs y el correo ya no se escribe en el log)
ENVIRONMENT=development

# Postgres. Acepta postgres://, postgresql:// o postgresql+psycopg:// (Neon, Supabase, Render...).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deploymenthub

# Aplica las migraciones de Alembic al arrancar (recomendado en hosting gratuito sin consola).
RUN_MIGRATIONS=true

# Clave de firma del JWT: mínimo 32 bytes. Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=COMPLETAR_clave_de_al_menos_32_bytes
JWT_ISSUER=DeploymentHub
JWT_AUDIENCE=DeploymentHub
JWT_EXPIRATION_MINUTES=60

# Orígenes del frontend permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost:5173

# Administrador inicial: se crea al arrancar si no hay ningún administrador activo.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# KRUD (asistente transversal). Sin KRUD_PRIVATE_JWK queda apagado y /api/krud/asercion responde 404.
KRUD_ISSUER=
KRUD_PRIVATE_JWK=
KRUD_AUDIENCE=velo-krud
KRUD_LIFETIME_SECONDS=60

# Correo (recuperación de contraseña y avisos). Sin EMAIL_HOST/EMAIL_FROM no se envía nada.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# Avisos por correo de cambios en solicitudes.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_PUBLIC_URL=
NOTIFICATIONS_GROUPING_SECONDS=5
